RewriteEngine On

# Never serve private configuration, environment files, or Git metadata.
RewriteRule ^(?:config|\.git)(?:/|$) - [F,L]
RewriteRule (^|/)(?:\.env(?:\..*)?|[^/]+\.env)$ - [F,L,NC]

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Remove "www." to prevent SSL mismatch warnings
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Feature files are reached through index.php, never by their disk paths.
RewriteRule ^app(?:/|$) - [F,L]

# Keep existing root-level PHP URLs, POST bodies, and query strings intact.
# index.php and existing files are served normally; missing PHP URLs are routed.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^[A-Za-z_][A-Za-z0-9_]*\.php$ index.php [L]
